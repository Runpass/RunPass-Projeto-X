{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "RunPass S02 identity candidate; NOT deployed. MFA evidence still enforced in API.",
  "Parameters": {
    "Environment": {
      "Type": "String",
      "AllowedValues": [
        "dev",
        "prod"
      ]
    }
  },
  "Conditions": {
    "IsDev": {
      "Fn::Equals": [
        {
          "Ref": "Environment"
        },
        "dev"
      ]
    }
  },
  "Resources": {
    "RunnerPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "runpass-${Environment}-runner"
        },
        "UsernameAttributes": [
          "email"
        ],
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "AutoVerifiedAttributes": [
          "email"
        ],
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": false
        },
        "MfaConfiguration": "OFF",
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 6,
            "RequireLowercase": false,
            "RequireUppercase": false,
            "RequireNumbers": false,
            "RequireSymbols": false
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "UserAttributeUpdateSettings": {
          "AttributesRequireVerificationBeforeUpdate": [
            "email"
          ]
        }
      }
    },
    "GoogleIdentityProvider": {
      "Type": "AWS::Cognito::UserPoolIdentityProvider",
      "Condition": "IsDev",
      "Properties": {
        "UserPoolId": {
          "Ref": "RunnerPool"
        },
        "ProviderName": "Google",
        "ProviderType": "Google",
        "ProviderDetails": {
          "client_id": "{{resolve:secretsmanager:runpass/dev/oauth/google:SecretString:client_id}}",
          "client_secret": "{{resolve:secretsmanager:runpass/dev/oauth/google:SecretString:client_secret}}",
          "authorize_scopes": "profile email openid"
        },
        "AttributeMapping": {
          "email": "email",
          "email_verified": "email_verified",
          "username": "sub"
        }
      }
    },
    "FacebookIdentityProvider": {
      "Type": "AWS::Cognito::UserPoolIdentityProvider",
      "Condition": "IsDev",
      "Properties": {
        "UserPoolId": {
          "Ref": "RunnerPool"
        },
        "ProviderName": "Facebook",
        "ProviderType": "Facebook",
        "ProviderDetails": {
          "client_id": "{{resolve:secretsmanager:runpass/dev/oauth/facebook:SecretString:app_id}}",
          "client_secret": "{{resolve:secretsmanager:runpass/dev/oauth/facebook:SecretString:app_secret}}",
          "authorize_scopes": "public_profile,email",
          "api_version": "v19.0"
        },
        "AttributeMapping": {
          "email": "email",
          "username": "id"
        }
      }
    },
    "RunnerPoolDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Condition": "IsDev",
      "Properties": {
        "Domain": "runpass-dev",
        "UserPoolId": {
          "Ref": "RunnerPool"
        }
      }
    },
    "RunnerClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "DependsOn": [
        "GoogleIdentityProvider",
        "FacebookIdentityProvider"
      ],
      "Properties": {
        "UserPoolId": {
          "Ref": "RunnerPool"
        },
        "GenerateSecret": false,
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "ExplicitAuthFlows": [
          "ALLOW_USER_PASSWORD_AUTH",
          "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "SupportedIdentityProviders": {
          "Fn::If": [
            "IsDev",
            [
              "COGNITO",
              "Google",
              "Facebook"
            ],
            [
              "COGNITO"
            ]
          ]
        },
        "AllowedOAuthFlowsUserPoolClient": {
          "Fn::If": [
            "IsDev",
            true,
            false
          ]
        },
        "AllowedOAuthFlows": {
          "Fn::If": [
            "IsDev",
            [
              "code"
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "AllowedOAuthScopes": {
          "Fn::If": [
            "IsDev",
            [
              "openid",
              "email",
              "profile"
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "CallbackURLs": {
          "Fn::If": [
            "IsDev",
            [
              "runpass://auth/callback"
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "LogoutURLs": {
          "Fn::If": [
            "IsDev",
            [
              "runpass://auth/logout"
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "AccessTokenValidity": 60,
        "IdTokenValidity": 60,
        "RefreshTokenValidity": 30,
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes",
          "RefreshToken": "days"
        },
        "ReadAttributes": [
          "email",
          "email_verified",
          "sub"
        ],
        "WriteAttributes": [
          "email"
        ]
      }
    },
    "OperatorPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "runpass-${Environment}-operator"
        },
        "UsernameAttributes": [
          "email"
        ],
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "AutoVerifiedAttributes": [
          "email"
        ],
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "MfaConfiguration": "ON",
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "admin_only",
              "Priority": 1
            }
          ]
        },
        "EnabledMfas": [
          "SOFTWARE_TOKEN_MFA"
        ],
        "UserAttributeUpdateSettings": {
          "AttributesRequireVerificationBeforeUpdate": [
            "email"
          ]
        }
      }
    },
    "OperatorClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "OperatorPool"
        },
        "GenerateSecret": false,
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "ExplicitAuthFlows": [
          "ALLOW_USER_PASSWORD_AUTH",
          "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "AccessTokenValidity": 60,
        "IdTokenValidity": 60,
        "RefreshTokenValidity": 1,
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes",
          "RefreshToken": "days"
        },
        "ReadAttributes": [
          "email",
          "email_verified",
          "sub"
        ],
        "WriteAttributes": [
          "email"
        ]
      }
    }
  },
  "Outputs": {
    "RunnerPool": {
      "Value": {
        "Ref": "RunnerPool"
      }
    },
    "RunnerClient": {
      "Value": {
        "Ref": "RunnerClient"
      }
    },
    "RunnerPoolDomain": {
      "Condition": "IsDev",
      "Value": {
        "Ref": "RunnerPoolDomain"
      }
    },
    "OperatorPool": {
      "Value": {
        "Ref": "OperatorPool"
      }
    },
    "OperatorClient": {
      "Value": {
        "Ref": "OperatorClient"
      }
    }
  }
}
